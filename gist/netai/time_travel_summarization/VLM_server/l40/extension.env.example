# L40용 확장 .env — 확장 루트(gist/netai/time_travel_summarization/.env)로 복사 후 값 기입.
# 공용 서버 수칙: 이 파일은 gitignore 대상(자격증명 포함). 홈 밖에 쓰지 말 것.

# 궤적 데이터: repo에 포함된 1분 CSV (확장 루트 기준 상대경로로 해석됨)
DATA_PATH="data/living_trajectory_1min_0.2s.csv"

# 실제 우주인 에셋(Nucleus). 주의: 비우면 repo 내장 assets/Astronaut.usd로 폴백되는데
# 이는 930바이트 캡슐 플레이스홀더(미터 단위)라 cm 씬에서 사실상 보이지 않고 충돌
# 반경도 달라진다(L40 스모크 실측). Nucleus 인증(OMNI_USER/OMNI_PASS) 후 이 경로 사용.
ASTRONAUT_USD_PATH="omniverse://10.38.38.32/Projects/Dream-AI_Plus_Twin/Workspace_Personal/swj/AI-Grad_Building/Human/Astronaut.usd"

# minIO (업로드/스테이징용 — 키는 Windows .env와 동일 값)
MINIO_ENDPOINT=https://api.minio.mobilex.kr
MINIO_SECURE=true
MINIO_BUCKET=time-travel-summarization
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

LAKE_DATASET=living_trajectory_1h_0_2s_parquet
