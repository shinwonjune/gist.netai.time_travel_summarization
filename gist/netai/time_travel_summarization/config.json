{
  "data_path": "${DATA_PATH}",

  "auto_generate": true,

  "astronaut_usd": "${ASTRONAUT_USD_PATH}",

  "prim_map": {},

  "visibility_groups": {
    "Furniture": ["/World/Furniture"],
    "Equipment": ["/World/Equipment"],
    "Ground": ["/World/Ground"],
    "A_Exterior": ["/World/A_Exterior"],
    "TimeTravel_Objects": ["/World/TimeTravel_Objects"]
  },

  "complexity_levels": {
    "Full": [],
    "Simplified": ["Furniture", "Equipment"],
    "Abstract": ["Furniture", "Equipment", "Ground", "A_Exterior", "TimeTravel_Objects"]
  },

  "video_output_dir": "artifacts/video",

  "output_root_uri": "s3://${MINIO_BUCKET}/timetravel",
  "event_list_uri": "s3://${MINIO_BUCKET}/timetravel/event_list",
  "video_output_uri": "s3://${MINIO_BUCKET}/timetravel/video",

  "lake": {
    "enabled": false,
    "manifest_uri": "s3://${MINIO_BUCKET}/trajectory/${LAKE_DATASET}/manifest.json",
    "cache_chunks": 4,
    "prefetch_ahead": 2
  }
}
